{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "baseUrl": ".",
        "types": ["vitest/globals", "@testing-library/jest-dom"]
    },
    "include": [
        "resources/js/Pages/AdminCompetency.tsx",

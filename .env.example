APP_NAME="Alibaton Workforce Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=alibaton_portal
DB_USERNAME=sail
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Keep log while developing. Switch to smtp locally when you are ready to
# receive Admin number-matching requests in Gmail.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Temporary project administrator account.
ALIBATON_ADMIN_EMAIL=admin@example.com
ALIBATON_ADMIN_PASSWORD=
PASSWORD_RECOVERY_ADMIN_EMAIL=

MFA_CHALLENGE_TTL_SECONDS=180
MFA_ENROLLMENT_TTL_MINUTES=10
MFA_RECOVERY_CODE_COUNT=8
MFA_ISSUER="Alibaton Construction"
MFA_APPROVAL_BASE_URL=http://localhost
MFA_TRUSTED_DEVICE_COOKIE=alibaton_mfa_device
MFA_TRUSTED_DEVICE_COOKIE_MINUTES=525600

LEARNING_OPERATIONAL_SEED=false
DEFENSE_READINESS_SEED_ENABLED=false
LEARNING_MATERIAL_MAX_BYTES=52428800
TRAINING_OPERATIONAL_SEED_ENABLED=false
SUCCESSION_OPERATIONAL_SEED_ENABLED=false
RECOGNITION_OPERATIONAL_SEED_ENABLED=false
TRAINING_WORKFORCE_ATTENDANCE_DRIVER=pending

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Server-only Groq configuration. Never expose GROQ_API_KEY through VITE_*.
GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1
GROQ_PERFORMANCE_MODEL=llama-3.3-70b-versatile
GROQ_LEARNING_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=20

PERFORMANCE_ANONYMOUS_FEEDBACK_ENABLED=false
PERFORMANCE_ANONYMOUS_FEEDBACK_MINIMUM=3

# Optional local-only Performance workflow simulation. Leave blank in production.
PERFORMANCE_REVIEW_DEMO_DATE=
